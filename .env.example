# Copy to .env and adjust if needed. The .env file is gitignored.
# This project needs NO secrets to run on the bundled synthetic scene.

# Override the directory the server is allowed to read scenes from.
# Defaults to <project>/data. Tools can ONLY access files inside this directory.
# RIVER_MCP_DATA_DIR=/absolute/path/to/your/scenes

# --- Only needed if you later add a tool that downloads REAL imagery ---
# Copernicus Data Space Ecosystem credentials (register free at dataspace.copernicus.eu).
# These are NOT used by the current tools and must never be committed.
# CDSE_CLIENT_ID=
# CDSE_CLIENT_SECRET=
